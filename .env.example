# ---- Claude AI (required for triage) ----
# Get a key from https://console.anthropic.com/ , or run `ant auth login`.
ANTHROPIC_API_KEY=

# Model used for triage. Defaults to claude-opus-5.
# For high volume you can switch to a cheaper model, e.g. claude-haiku-4-5.
INSTA_LEADS_MODEL=claude-opus-5

# ---- Local storage ----
INSTA_LEADS_DB=leads.db

# ---- Instagram Graph API (OPTIONAL) ----
# Only needed if you want to pull comments from / reply on YOUR OWN
# Instagram Business or Creator account (the account you own or manage).
# You get these from a Meta App with instagram_manage_comments permission.
# Leave blank to work purely from CSV import.
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
IG_GRAPH_VERSION=v21.0
